# ==============================================================================
# Stellar Sentinel - Production Monorepo Git Ignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL)
# ------------------------------------------------------------------------------
*.env
*.env.*
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
.env
agent/.env
web/.env

# Retain template examples
!.env.example
!agent/.env.example

# Private Key & Keystore dumps
*.pem
*.key
*.pkcs12
*.p12

# ------------------------------------------------------------------------------
# 2. Python (ML Agent, Listeners, Daemon)
# ------------------------------------------------------------------------------
__pycache__/
*/__pycache__/
agent/__pycache__/
*.py[cod]
*$py.class

# Python Virtual Environments
venv/
*/venv/
agent/venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Distribution, Packaging & Eggs
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Unit tests, Coverage & Type Checking
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.mypy_cache/
.dmypy.json
dmypy.json

# Local / Legacy Backup Dumps
agent/Prev Files Sept 24/
*Prev Files*

# ------------------------------------------------------------------------------
# 3. Rust & Soroban Smart Contracts
# ------------------------------------------------------------------------------
# Cargo build output & compiled WebAssembly binaries
target/
contracts/target/
contracts/sentinel_treasury/target/
*.wasm
*.wasm.d

# Cargo Lock override (Uncomment only if you do NOT want contract lockfile tracked)
# contracts/Cargo.lock

# Backup directories in contracts
contracts/backup/

# ------------------------------------------------------------------------------
# 4. Web Application (React, Vite, TypeScript)
# ------------------------------------------------------------------------------
node_modules/
web/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite / React Production Builds
dist/
web/dist/
dist-ssr/
web/dist-ssr/
*.local

# Vercel Deployment Artifacts
.vercel/
web/.vercel/

# TypeScript & ESLint Cache
*.tsbuildinfo
.eslintcache

# Temporary / Scratchpad Reference Files inside components/pages
web/src/pages/ongoingintent.txt
web/src/components/payment/PaymentForm.txt
web/src/services/contractClient.txt

# ------------------------------------------------------------------------------
# 5. Editor, IDE & System Overhead
# ------------------------------------------------------------------------------
.vscode/*
